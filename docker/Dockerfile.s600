# bllm-serve (S600 / nash-p) — OpenAI-compatible HTTP inference server for the
# BLLM native runtime on RDK **S600** (aarch64). Sibling of ./Dockerfile (S100).
#
# Why a separate S600 image:
#   * Base is ubuntu:24.04 (glibc 2.39): the S600 board's libs staged below need
#     GLIBC_2.38, which ubuntu:22.04 (glibc 2.35) cannot provide.
#   * The hobot runtime is staged from the S600 board itself. The conda packages
#     carry none (0.9.0+): the runtime has to match the board's firmware, and the
#     S100 build that `hobot-dnn` / `hobot-dnn-s600` used to bring is exactly what
#     must not run on an S600. The bllm binaries are the same as on S100.
#   * A nash-p .hbm must be compiled by a toolchain the S600 board's runtime can
#     load; a too-new one fails at load with "libhbrt4.so needs to be updated".
#
# What is baked in : ubuntu24.04 + python3.12 + bllm/libbllm/tokenizers-cpp (conda)
#                    + the S600 board's hobot runtime + HAL closure.
# What is NOT baked : kernel BPU driver + /dev nodes (mapped at run time) and the
#                     .hbm model (mounted as a volume; general image).
#
# Build context is this docker/ dir. Run stage-libs-s600.sh first (stages the S600
# board's /usr/hobot/lib closure into _stage_s600/ — proprietary, gitignored), then:
#   docker build -f Dockerfile.s600 -t bllm-serve-s600:latest .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl bzip2 busybox-static \
        libcjson1 libjsoncpp25 \
    && rm -rf /var/lib/apt/lists/*

# --- python 3.12 + our stack from the conda channel -------------------------
ARG MAMBA_VERSION=1.5.8
ARG BLLM_CHANNEL=https://mirrors.ruis.ai/conda
# Pinned so this layer is not silently reused with a stale runtime: the
# install line is otherwise identical across releases, so Docker would cache
# it and the image would keep shipping whatever bllm it first resolved.
ARG BLLM_VERSION=0.9.0
ENV MAMBA_ROOT_PREFIX=/opt/conda
ENV PATH=/opt/conda/bin:$PATH
RUN curl -Ls "https://micro.mamba.pm/api/micromamba/linux-aarch64/${MAMBA_VERSION}" \
        | tar -xj -C /tmp bin/micromamba \
    && /tmp/bin/micromamba create -y -p /opt/conda \
        -c "${BLLM_CHANNEL}" -c conda-forge \
        python=3.12 bllm=${BLLM_VERSION} libbllm=${BLLM_VERSION} tokenizers-cpp \
    && /tmp/bin/micromamba clean -a -y \
    && rm -rf /opt/conda/pkgs /tmp/bin \
    && find /opt/conda -type f -name '*.pyc' -delete \
    && find /opt/conda -type d -name '__pycache__' -exec rm -rf {} +

# --- pure-python HTTP layer -------------------------------------------------
COPY requirements.txt /tmp/req.txt
RUN /opt/conda/bin/pip install --no-cache-dir -r /tmp/req.txt

# --- the S600 board's hobot runtime + HAL (staged from the board) ------------
# Mirror the board path so the /usr/hobot/lib RPATH in libbllm resolves too.
COPY _stage_s600/hobot/lib/ /usr/hobot/lib/
ENV LD_LIBRARY_PATH=/usr/hobot/lib:/opt/conda/lib

# --- server -----------------------------------------------------------------
COPY server.py /app/server.py
COPY serving/ /app/serving/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /app
EXPOSE 8866
ENTRYPOINT ["/entrypoint.sh"]
