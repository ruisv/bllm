# =============================================================================
# PRIVATE / LOCAL DEV CONTEXT — never commit (open-source repo; keep infra &
# agent config out of history).
# NOTE: gitignore has NO inline comments — a '#' after a pattern is literal.
# =============================================================================

# RDK skills mirror + agent settings (local editing aid)
.claude/
# agent runtime config
.agents/
# agent instructions
AGENTS.md
CLAUDE.md
# our internal remote-dev workflow (edit-on-host / rsync-to-board); customers build
# directly on the board with scripts/build.sh, so these stay local, not tracked
scripts/sync.sh
scripts/board_build.sh
scripts/board_test.sh
# machine table / ssh aliases / server + board usage (private)
CLAUDE.local.md
# infra topology: hostnames, IPs, convert-host workflow (private)
docs/INFRA.md
# S600 on-board test record: sandbox creds + dgx2 paths (private)
docs/S600_ONBOARD.md
# any *.local override files
*.local

# =============================================================================
# SDK / models / large binaries — pulled per-machine, too large / licensed
# =============================================================================
D-Robotics_LLM_*/
*.tar.gz
*.zip
*.hbm
*.gguf
*.bin
*.onnx
*.safetensors
models/
oellm_runtime/

# =============================================================================
# Docker build staging — proprietary BPU libs (stage-libs.sh) and the baked
# model package (bake-model.sh), copied from the board at build; never commit.
# =============================================================================
docker/_stage/
docker/_model/

# =============================================================================
# SDK mirror for IntelliSense (mirror of board /usr/include/hobot)
# =============================================================================
third_party/

# =============================================================================
# build artifacts
# =============================================================================
build/
*.so
*.o
*.a
compile_commands.json

# =============================================================================
# python
# =============================================================================
__pycache__/
*.egg-info/
.pytest_cache/
*.pyc

# =============================================================================
# editor / os
# =============================================================================
.vscode/
.cache/
.DS_Store

# model-conversion method — CLOSED (we publish finished .hbm, not the how-to)
host_toolchain/
