@PACKAGE_INIT@

# BLLM is the self-built hbDNN runtime — `bllm::native` (the libxlm backend was removed;
# see docs/MIGRATION.md, tag v-libxlm-final). These flags say what the install carries.
set(BLLM_HAVE_NATIVE     @BLLM_HAVE_NATIVE@)
set(BLLM_HAVE_TOKENIZERS @BLLM_HAVE_TOKENIZERS@)

include(CMakeFindDependencyMacro)
# The Find modules we install alongside this config resolve the board's runtimes.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(BLLM_HAVE_NATIVE)
  find_dependency(Hobot)          # hobot::dnn — hbDNN / hbUCP / HBRT
  if(BLLM_HAVE_TOKENIZERS)
    find_dependency(Tokenizers)   # tokenizers::tokenizers — HF tokenizers (Rust)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bllmTargets.cmake")

check_required_components(bllm)
